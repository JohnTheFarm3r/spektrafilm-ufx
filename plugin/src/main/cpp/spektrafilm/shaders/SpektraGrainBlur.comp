void main() {
  const uint operation = specializedOperation == 0xffffffffu ? params.operation : specializedOperation;
  const uvec3 activeGid = gl_GlobalInvocationID.xyz;
  if (operation == kOpFrameConstants) {
    if (activeGid.x < 11u && activeGid.y == 0u && activeGid.z == 0u) buildBlurConstants(activeGid.x);
    return;
  }
  const uint activeWidth = params.activeWidth == 0u ? params.width : params.activeWidth;
  const uint activeHeight = params.activeHeight == 0u ? params.height : params.activeHeight;
  if (activeGid.x >= activeWidth || activeGid.y >= activeHeight) return;
  const uvec3 gid = uvec3(activeGid.xy + uvec2(params.activeOriginX, params.activeOriginY), activeGid.z);
  if (gid.x >= params.width || gid.y >= params.height) return;
  const uint index = gid.y * params.width + gid.x;
  if (operation == kOpLayerBlurX && gid.z < 9u) {
    write_grainLayerB(index * 9u + gid.z, cachedLayerBlurX(gid, true));
  } else if (operation == kOpLayerBlurY && gid.z < 9u) {
    write_grainLayerA(index * 9u + gid.z, cachedLayerBlurY(gid, false));
  } else if (operation == kOpMicroBlurX) {
    storeMicroBPixel(index, cachedBlurMicroX(gid.xy));
  } else if (operation == kOpMicroBlurY) {
    storeMicroAPixel(index, cachedBlurMicroY(gid.xy));
  } else if (operation == kOpDensityBlurX || operation == kOpDensityBlurY) {
    storeDestinationPixel(index, operation == kOpDensityBlurX ? cachedDensityBlurX(gid.xy) : cachedDensityBlurY(gid.xy));
  }
}
