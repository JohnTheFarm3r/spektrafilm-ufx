vec4 cachedDensityBlurX(uvec2 gid) {
  const float sigma = f(SPEKTRA_GRAIN_BLUR_BASE + 10u * SPEKTRA_GRAIN_BLUR_STRIDE);
  if (sigma <= 0.0 || (u(kFrameIntGrainSublayersEnabled) == 0u && sigma <= 0.4)) {
    return sampleSource(int(gid.x), int(gid.y));
  }
  if (u(kFrameIntGrainBlurRecurrence) != 0u) {
    const GaussianBlurInfo info = loadGaussianBlurInfo(10u);
    const int x = int(gid.x);
